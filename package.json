{
  "name": "jalanin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run prisma:generate && next build --webpack",
    "vercel-build": "npm run build",
    "start": "next start",
    "prisma:compile": "tsc --ignoreConfig --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --esModuleInterop --noEmit false --declaration false --sourceMap false --outDir generated/prisma-js generated/prisma/client.ts generated/prisma/browser.ts generated/prisma/commonInputTypes.ts generated/prisma/enums.ts generated/prisma/models.ts generated/prisma/internal/class.ts generated/prisma/internal/prismaNamespace.ts generated/prisma/internal/prismaNamespaceBrowser.ts generated/prisma/models/*.ts && cp -R generated/prisma-js/. generated/prisma/ && rm -rf generated/prisma-js",
    "prisma:generate": "prisma generate && npm run prisma:compile",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:verify": "tsx scripts/verify-prisma.ts",
    "prisma:studio": "prisma studio",
    "storage:setup": "tsx scripts/setup-blob-storage.ts"
  },
  "prisma": {
    "seed": "./node_modules/.bin/tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "latest",
    "maplibre-gl": "^5.24.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
